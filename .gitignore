*.pyc
.ipynb_checkpoints/
.DS_Store

# Own photos for the "others" class (kept locally and on Drive, not in git)
classification/others/

# Cache of the course images for the OTHERS training (upload to Drive IE7615_project/cache/, not git)
detection/cluster/IE7615_project/cache/

# Run folders downloaded from the cluster (weights, generated data). Their reports are copied into
# detection/results/ablation/runs/ and everything is imported into MLflow (mlops/tools/import_runs.py).
/runs/

# MLflow store and exported model bundles: local only. mlops/logs/ (run-ID map, rollback log) is in git.
mlops/store/
model_bundles/

# Real multi-object photos: the converted JPGs (EXIF stripped) and labels are in git (detection/data/real_photos/);
# the phone originals live outside the repository, prediction images are regenerated by eval_real_photos.py.
detection/results/real_photos/predictions/

# Backup written by detection/src/review_masks.py on its first save
detection/data/masks/mask_review_backup.csv
